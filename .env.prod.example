# ============================================================
# AutoTeams 生产环境变量示例
# P1-07-C: 从 .env.example 拆分
#
#   cp .env.prod.example .env.prod
#   cp .env.prod.db.example .env.prod.db   # 数据库凭据单独成文件（见下）
#   docker compose -f docker-compose.prod.yml \
#     --env-file .env.prod --env-file .env.prod.db up -d
#
# 特点：
# - DEBUG=false（强制），JWT 密钥不安全则拒绝启动
# - 后端不暴露宿主机端口（仅通过 nginx 反代）
# - DB/Redis 密码必须为强密码
# - /metrics 端点加 token 保护
# - **本文件不包含任何数据库口令**。admin / app / worker / bootstrap 四个口令都在
#   `.env.prod.db`，而 `.env.prod.db` **不会**被写入任何容器，只用于 compose 变量
#   插值；每个服务只在自己的 `environment` 里拿到属于自己的那一个 URL。
#   （需要 Docker Compose v2.17+ 支持多个 --env-file。）
# - 日志持久化到命名卷
# ============================================================

# -------------------- 数据库 --------------------
# 数据库凭据已移出本文件，见同目录 .env.prod.db.example。
# 角色分工（角色名由迁移创建，不要改名字）：
#   POSTGRES_USER     仅 postgres 容器 + migrate 一次性服务（只做 DDL）
#   autoteams_app       API 运行角色（没有任何跨租户队列能力）
#   autoteams_worker    三个队列 Worker（额外持有领取/恢复函数）
#   autoteams_bootstrap 渠道回调引导（零表权限，只读验签材料）
# 生产环境必须设为 false，强制使用 PostgreSQL（database.py 优先读 DATABASE_URL）
USE_SQLITE=false
# DATABASE_URL / DATABASE_WORKER_URL / DATABASE_BOOTSTRAP_URL 均由
# docker-compose.prod.yml 用 .env.prod.db 的口令插值拼装，不要在这里覆盖

# -------------------- 演示数据安全边界 --------------------
# 生产默认禁止写入 demo 企业、账号、对话与向量。仅在隔离的评审/演示数据库中设为 1。
SEED_DEMO=0

# P1/P2-INFRA: 数据库连接池调优（仅 PostgreSQL 生效）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# -------------------- Redis（生产必填，强密码）--------------------
REDIS_PASSWORD=PLEASE_CHANGE_TO_STRONG_PASSWORD_AT_LEAST_32_CHARS

# -------------------- ChromaDB --------------------
# Docker Compose 部署：保留默认 chromadb
# Railway/Vercel 单容器部署：把 CHROMA_HOST 设为空字符串，使用嵌入式模式（无需独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# P0-06: 生产环境强烈建议设置 ChromaDB 认证（HttpClient 模式才需要）
CHROMA_AUTH_TOKEN=PLEASE_CHANGE_TO_RANDOM_TOKEN
# 嵌入式模式持久化目录（CHROMA_HOST 为空时生效）
CHROMA_PERSIST_DIR=/app/data/chroma

# -------------------- JWT（生产必填，否则启动失败）--------------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=PLEASE_CHANGE_TO_RANDOM_32BYTE_HEX_STRING
JWT_ALGORITHM=HS256
# 3.1.2: 审计链 HMAC 签名密钥（生产环境必须设置，与 JWT_SECRET_KEY 不同）
# 留空会回退到 JWT_SECRET_KEY（启动会记录 warning，且 JWT 轮换会破坏历史审计链）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_SIGNING_KEY=
# 外部 Agent API 机器密钥摘要专用 HMAC 密钥（生产环境必须设置，不能复用 JWT/AUDIT 密钥）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_API_KEY_HMAC_SECRET=
AGENT_API_KEY_PREFIX=afd_sk_
AGENT_API_RATE_LIMIT_PER_MINUTE=60
# 生产环境建议缩短 access token 有效期

JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ISSUER=
JWT_AUDIENCE=

# -------------------- LLM API（至少一组必填）--------------------
# P0-S2: 默认 LLM provider；模型名无 provider 前缀时会自动拼接为 <provider>/<model>
# 常用值：deepseek, doubao, qwen, zhipu, moonshot, openai, anthropic, azure
# 复赛/国内部署推荐：DeepSeek（国内可用、成本低、效果强），无需 OpenAI Key 即可体验
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek 默认配置（国内推荐，OpenAI 兼容接口）
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_MODEL=deepseek/deepseek-chat
# 强模型（用于 chat 主问答与复杂推理，未设置则回退到 OPENAI_MODEL）
OPENAI_MODEL_STRONG=deepseek/deepseek-chat
# 廉价模型（查询分类、Self-RAG 评估等轻量任务）
OPENAI_MODEL_CHEAP=deepseek/deepseek-chat
# P1-5: 生产环境严禁启用 LLM 演示模式；未配置真实 API Key 时服务应拒绝 LLM 调用
LLM_ALLOW_FALLBACK=false
# P1-RAG: 中文 embedding 模型；留空则使用 ChromaDB 默认英文模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# P1-RAG: 是否启用 LLM 重排序
RERANK_ENABLED=true
LLM_FALLBACK_MODELS=
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
MAX_CONTEXT_TOKENS=6000

# 国产模型示例（生产环境推荐，国内评委可零 OpenAI Key 体验）：
# 豆包：DEFAULT_LLM_PROVIDER=doubao
# OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_API_KEY=your-doubao-api-key
# OPENAI_MODEL=doubao/doubao-pro-32k
# OPENAI_MODEL_STRONG=doubao/doubao-pro-128k
# OPENAI_MODEL_CHEAP=doubao/doubao-lite-32k
# MULTIMODAL_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# MULTIMODAL_API_KEY=your-doubao-api-key
# MULTIMODAL_MODEL=doubao/doubao-vision-pro-32k

# 通义千问：DEFAULT_LLM_PROVIDER=qwen
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=your-dashscope-api-key
# OPENAI_MODEL=qwen/qwen-plus
# OPENAI_MODEL_STRONG=qwen/qwen-max
# OPENAI_MODEL_CHEAP=qwen/qwen-turbo

# 智谱 GLM：DEFAULT_LLM_PROVIDER=zhipu
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_MODEL=zhipu/glm-4-air
# OPENAI_MODEL_STRONG=zhipu/glm-4
# OPENAI_MODEL_CHEAP=zhipu/glm-4-flash

# DeepSeek：DEFAULT_LLM_PROVIDER=deepseek
# OPENAI_API_BASE=https://api.deepseek.com
# OPENAI_API_KEY=your-deepseek-api-key
# OPENAI_MODEL=deepseek/deepseek-chat
# OPENAI_MODEL_STRONG=deepseek/deepseek-chat
# OPENAI_MODEL_CHEAP=deepseek/deepseek-chat

# Moonshot：DEFAULT_LLM_PROVIDER=moonshot
# OPENAI_API_BASE=https://api.moonshot.cn/v1
# OPENAI_API_KEY=your-moonshot-api-key
# OPENAI_MODEL=moonshot/moonshot-v1-32k
# OPENAI_MODEL_STRONG=moonshot/moonshot-v1-128k
# OPENAI_MODEL_CHEAP=moonshot/moonshot-v1-8k

# 多模态 LLM
MULTIMODAL_API_KEY=your-multimodal-api-key
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_MODEL=gpt-4-vision-preview

# Whisper
WHISPER_MODEL=whisper-1

# -------------------- 服务（生产模式）--------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# BE-SEC-07: 受信反向代理跳数（nginx/反代部署通常为 1），用于从 XFF 解析真实客户端 IP
TRUSTED_PROXY_COUNT=1

# 注册策略：false=邀请制（更安全，评委通过邀请链接注册）
REGISTRATION_ENABLED=false

# -------------------- 速率限制 --------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_SCAN_PER_MINUTE=5
RATE_LIMIT_SSE_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=20
RATE_LIMIT_HEALTH_PER_MINUTE=60
RATE_LIMIT_METRICS_PER_MINUTE=60

# -------------------- 文件上传限制 --------------------
UPLOAD_ROOT=/app/uploads
MAX_FILE_SIZE_DOCUMENT=52428800
MAX_FILE_SIZE_IMAGE=20971520
MAX_FILE_SIZE_VIDEO=524288000
MAX_FILE_SIZE_AUDIO=209715200
MAX_CHUNK_INPUT_CHARS=5000000

# -------------------- LangGraph 状态持久化 --------------------
LANGGRAPH_CHECKPOINT_PATH=/app/data/langgraph_checkpoints.sqlite

# -------------------- 日志（P1-06）--------------------
LOG_DIR=/app/logs
# P1-06-E: /metrics 端点访问控制（设置后 Prometheus 抓取需带 ?token=xxx）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(16))"
METRICS_AUTH_TOKEN=PLEASE_CHANGE_TO_RANDOM_TOKEN

# -------------------- Sentry 错误上报（P3-2，可选但强烈建议配置）--------------------
# 在 Sentry 创建项目后，将 DSN 粘贴到这里；为空则禁用
SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
# 0.0 仅上报错误；如需性能监控可逐步提高（如 0.1）
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0

# -------------------- 前端 --------------------
# 生产环境用 /api/v1，nginx 反代到后端容器
VITE_API_BASE_URL=/api/v1

# -------------------- 端口（docker-compose.prod.yml 用）--------------------
FRONTEND_PORT=80

# -------------------- 镜像（P0-3: GHCR 预构建镜像）--------------------
# CI (deploy.yml) 构建并推送到 GHCR 后，生产环境通过 docker compose pull 拉取
# 格式：ghcr.io/<github-owner>/<repo>-<service>:<tag>
# 默认使用 latest 标签；如需固定版本，改为 sha-<commit-sha> 或日期标签
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/autoteams-backend:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/autoteams-frontend:latest
COLLAB_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/autoteams-collab:latest

# -------------------- 备份（P1-08 + P3-4）--------------------
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
UPLOADS_DIR=/app/uploads
# P3-4: GPG 对称加密密码（生产必填，用于加密备份归档）。
# 丢失此密码将无法恢复备份，务必异地安全保存。
BACKUP_ENCRYPTION_KEY=PLEASE_CHANGE_TO_STRONG_BACKUP_PASSWORD_AND_KEEP_OFFSITE

# -------------------- CORS（P0 安全加固）--------------------
# 允许的前端源（逗号分隔），生产环境必须设置为你的域名
CORS_ALLOWED_ORIGINS=https://your-domain.com

# FE-SEC-03: 前端应用公网地址，用于后端生成完整邀请链接
FRONTEND_URL=https://your-domain.com

# -------------------- Cookie（P1-1 HttpOnly Token + BE-SEC-01 CSRF）--------------------
# 生产环境必须 HTTPS；若前端与后端不同域名（如 Vercel + Railway），必须 SameSite=None
# DEBUG=false 时 COOKIE_SECURE 必须为 true，否则后端拒绝启动
COOKIE_SECURE=true
COOKIE_SAMESITE=None
# COOKIE_DOMAIN=your-domain.com
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token

# -------------------- 本地工具桥接（Local Runner）--------------------
# 生产必填，否则后端拒绝启动；Backend 与 collaboration-service 必须配置相同值。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_INTERNAL_SECRET=PLEASE_CHANGE_TO_RANDOM_SECRET
# 后端调用协作服务的内网地址（compose 内覆盖为 http://collaboration-service:3001，勿改为公网）
COLLAB_SERVICE_URL=http://127.0.0.1:3001
# 本地 Runner 公网桥接地址（用于生成用户本机连接命令；nginx 需把 /bridge 反代到协作服务）。
# 云端单域名部署时设为公网域名根，如 https://your-domain.com
RUNNER_PUBLIC_BRIDGE_URL=https://your-domain.com
# 本地 Runner 公网分发包下载基地址（install.ps1 从中下载 local-runner.zip），
# 云端单域名部署时如 https://your-domain.com/local-runner
AUTOTEAMS_RUNNER_DOWNLOAD_BASE=https://your-domain.com/local-runner

# -------------------- 协作服务 sandbox（AUD-02）--------------------
# 生产默认拒绝 bash：留空允许列表 = 模型无法执行任何命令。
# 保持默认拒绝；确需放行时按最小前缀逐条添加，并配合容器隔离。
# 允许执行的命令前缀，英文逗号分隔；留空 = 全部拒绝。
#COLLAB_SANDBOX_BASH_ALLOWLIST=
# 单条 bash 命令的最长执行时间（毫秒）
#COLLAB_SANDBOX_BASH_TIMEOUT_MS=60000
# 单条 bash 命令的输出上限（字节）
#COLLAB_SANDBOX_BASH_MAX_OUTPUT_BYTES=262144
# 逃生舱：允许执行允许列表之外的任意命令。生产必须保持 false（未取消注释）。
# 置为 true 会打印显式告警，并让模型可在容器内执行任意代码。
#COLLAB_SANDBOX_ALLOW_UNRESTRICTED_BASH=false
