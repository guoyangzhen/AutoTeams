# ============================================================
# AutoTeams 统一编辑器规范
# ------------------------------------------------------------
# 与 .gitattributes 保持一致：仓库内文本统一 LF。
# 两者必须同步修改，否则 Windows 检出（core.autocrlf=true）
# 会让 .gitattributes 的 eol=lf 与 .editorconfig 互相打架，
# 出现「编辑器按 CRLF 存、git 按 LF 提交」的抖动与整文件 diff。
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ============================================================
# Shell：必须 LF，否则 bash 解析报错
# 参见 .gitattributes 头部说明（set -o pipefail invalid option）
# ============================================================
[*.sh]
indent_size = 2

[*.bash]
indent_size = 2

# ============================================================
# Python：PEP 8 四空格
# ============================================================
[*.py]
indent_size = 4
max_line_length = 120

[*.pyi]
indent_size = 4

# ============================================================
# 前端：Prettier / ESLint 默认两空格
# ============================================================
[*.{js,jsx,ts,tsx,mjs,cjs,vue,svelte}]
indent_size = 2

[*.{css,scss,sass,less}]
indent_size = 2

[*.{html,htm}]
indent_size = 2

# ============================================================
# 数据与配置
# ============================================================
[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.xml]
indent_size = 2

[*.{ini,cfg,conf}]
indent_size = 4

# ============================================================
# 文档
# 行尾两个空格在 Markdown 中是「硬换行」语法，
# 因此这里不能裁剪尾随空白，否则会破坏换行语义。
# ============================================================
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{adoc,rst}]
indent_size = 2
trim_trailing_whitespace = false

# ============================================================
# Makefile / Dockerfile 等必须用 Tab 缩进的格式
# ============================================================
[{Makefile,makefile,*.mk}]
indent_style = tab

[Dockerfile*]
indent_style = space
indent_size = 2

# ============================================================
# 不做尾随空白裁剪 / 不动格式的产物文件
# ============================================================
[*.{min.js,min.css,map,lock}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset

[*.md.{yml,yaml,json}]
insert_final_newline = unset
trim_trailing_whitespace = unset
