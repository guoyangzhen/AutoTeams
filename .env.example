# ============================================================
# AutoTeams 环境变量示例
# P0-09-F: 更新示例，标注生产必填项
# ============================================================

# -------------------- 数据库（生产必填）--------------------
# docker-compose 会用 POSTGRES_USER/PASSWORD/DB 自动拼接 DATABASE_URL
# 仅在非 compose 环境（如本地开发或 K8s）需要直接设置 DATABASE_URL
POSTGRES_USER=autoteams
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=autoteams
# 生产/Docker 部署必须设为 false，强制使用 PostgreSQL
# 开发模式可设为 true 或留空（默认走 SQLite）
USE_SQLITE=false
# DATABASE_URL=postgresql+asyncpg://autoteams:CHANGE_ME_TO_STRONG_PASSWORD@localhost:5432/autoteams

# P1/P2-INFRA: 数据库连接池调优（仅 PostgreSQL 生效）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# -------------------- Redis（生产必填）--------------------
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# REDIS_URL 由 compose 自动拼接，无需手动设置

# -------------------- ChromaDB --------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# P0-06: ChromaDB 认证 token（生产环境强烈建议设置）
CHROMA_AUTH_TOKEN=

# -------------------- JWT（生产必填，否则启动失败）--------------------
# P0-09-C: DEBUG=false 时使用默认密钥会直接 raise RuntimeError 拒绝启动
JWT_SECRET_KEY=PLEASE_CHANGE_TO_RANDOM_32BYTE_HEX_STRING
JWT_ALGORITHM=HS256
# 3.1.2: 审计链 HMAC 签名密钥（独立于 JWT_SECRET_KEY）
# - 留空时回退到 JWT_SECRET_KEY（向后兼容）
# - 生产环境强烈建议设置独立密钥，避免 JWT 轮换导致历史审计链校验失败
#   生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_SIGNING_KEY=
# 外部 Agent REST API 密钥摘要专用 HMAC 密钥（生产环境必须设置，不能复用 JWT 密钥）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_API_KEY_HMAC_SECRET=
# 机器密钥前缀与每分钟调用上限
AGENT_API_KEY_PREFIX=afd_sk_
AGENT_API_RATE_LIMIT_PER_MINUTE=60
# P0-S3: access token 有效期建议 1 小时（60 分钟），降低被盗用窗口

JWT_EXPIRATION_HOURS=1
# 运行影响审计 Fix5: 与 config.py 默认值（7 天）保持一致，避免模板与代码默认不一致
JWT_REFRESH_EXPIRATION_DAYS=7
# P2-09: JWT iss/aud 声明（可选，防止 token 跨系统重放）
JWT_ISSUER=
JWT_AUDIENCE=

# -------------------- LLM API（至少一组必填）--------------------
# P0-S2: 默认 LLM provider；模型名无 provider 前缀时会自动拼接为 <provider>/<model>
# 常用值：deepseek, doubao, qwen, zhipu, moonshot, openai, anthropic, azure
# 复赛/国内部署推荐：DeepSeek（国内可用、成本低、效果强），无需 OpenAI Key 即可体验
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek 默认配置（国内推荐，OpenAI 兼容接口）
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_MODEL=deepseek/deepseek-chat
# 强模型（用于 chat 主问答与复杂推理，未设置则回退到 OPENAI_MODEL）
OPENAI_MODEL_STRONG=deepseek/deepseek-chat
# 廉价模型（用于查询分类、Self-RAG 评估等轻量任务）
OPENAI_MODEL_CHEAP=deepseek/deepseek-chat
# P1-5: 是否允许 LLM 演示模式（无 API Key 时返回 fallback 响应）
# 生产环境必须设为 false（默认 false）；开发环境可设为 true
LLM_ALLOW_FALLBACK=false
# P1-RAG: 中文 embedding 模型；留空则使用 ChromaDB 默认英文模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# P1-RAG: 是否启用 LLM 重排序（复杂查询可提升相关性，简单查询可关闭以降低成本）
RERANK_ENABLED=true
# 故障转移备用模型列表（逗号分隔，litellm 格式，如 "deepseek/deepseek-chat,qwen/qwen-plus"）
LLM_FALLBACK_MODELS=
# LLM 请求超时（秒）
LLM_REQUEST_TIMEOUT=120
# LLM 最大重试次数（主模型失败后尝试备用模型）
LLM_MAX_RETRIES=2
# 对话上下文最大 token 预算（含 system + history + context + query）
MAX_CONTEXT_TOKENS=6000

# OpenAI 兼容（如需使用 OpenAI，取消注释并把 DEFAULT_LLM_PROVIDER 改为 openai）
# DEFAULT_LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4
# OPENAI_MODEL_STRONG=gpt-4-turbo
# OPENAI_MODEL_CHEAP=gpt-3.5-turbo

# 豆包（火山引擎）示例：设置 DEFAULT_LLM_PROVIDER=doubao
# OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_API_KEY=your-doubao-api-key
# OPENAI_MODEL=doubao/doubao-pro-32k
# OPENAI_MODEL_STRONG=doubao/doubao-pro-128k
# OPENAI_MODEL_CHEAP=doubao/doubao-lite-32k
# MULTIMODAL_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# MULTIMODAL_API_KEY=your-doubao-api-key
# MULTIMODAL_MODEL=doubao/doubao-vision-pro-32k

# 通义千问/DashScope 示例：设置 DEFAULT_LLM_PROVIDER=qwen
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=your-dashscope-api-key
# OPENAI_MODEL=qwen/qwen-plus
# OPENAI_MODEL_STRONG=qwen/qwen-max
# OPENAI_MODEL_CHEAP=qwen/qwen-turbo

# 智谱 GLM 示例：设置 DEFAULT_LLM_PROVIDER=zhipu
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_MODEL=zhipu/glm-4-air
# OPENAI_MODEL_STRONG=zhipu/glm-4
# OPENAI_MODEL_CHEAP=zhipu/glm-4-flash

# Moonshot 月之暗面示例：设置 DEFAULT_LLM_PROVIDER=moonshot
# OPENAI_API_BASE=https://api.moonshot.cn/v1
# OPENAI_API_KEY=your-moonshot-api-key
# OPENAI_MODEL=moonshot/moonshot-v1-32k
# OPENAI_MODEL_STRONG=moonshot/moonshot-v1-128k
# OPENAI_MODEL_CHEAP=moonshot/moonshot-v1-8k

# 多模态 LLM（图片/视频理解）
MULTIMODAL_API_KEY=your-multimodal-api-key
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_MODEL=gpt-4-vision-preview

# Whisper（音频/视频转写）
WHISPER_MODEL=whisper-1

# -------------------- 服务 --------------------
HOST=0.0.0.0
PORT=8000
# 生产环境必须设为 false（否则 JWT_SECRET_KEY 校验会拒绝启动）
DEBUG=false

# -------------------- 速率限制（P0-11）--------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_SCAN_PER_MINUTE=5
# P1-02-D: SSE 流式聊天限流（比普通 chat 更严格）
RATE_LIMIT_SSE_PER_MINUTE=10
# P1/P2-INFRA: 通用业务端点、管理操作、健康检查、监控指标限流
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=20
RATE_LIMIT_HEALTH_PER_MINUTE=60
RATE_LIMIT_METRICS_PER_MINUTE=60

# -------------------- 日志与监控（P1-06）--------------------
LOG_DIR=./logs
# P1-06-E: /metrics 端点访问控制（为空则不启用，生产建议设置）
METRICS_AUTH_TOKEN=

# -------------------- Sentry 错误上报（P3-2，可选）--------------------
# 后端 DSN，为空则禁用
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0 表示仅上报错误，不采集性能事务；1.0 表示全量事务追踪
SENTRY_TRACES_SAMPLE_RATE=0.0
# 前端 DSN（通常与后端使用同一 Sentry 项目的不同 DSN，或同一 DSN）
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0

# -------------------- 文件上传限制（P0-07）--------------------
UPLOAD_ROOT=./uploads
MAX_FILE_SIZE_DOCUMENT=52428800     # 50MB
MAX_FILE_SIZE_IMAGE=20971520        # 20MB
MAX_FILE_SIZE_VIDEO=524288000       # 500MB
MAX_FILE_SIZE_AUDIO=209715200       # 200MB
MAX_CHUNK_INPUT_CHARS=5000000       # 5MB

# -------------------- LangGraph 状态持久化（P0-14）--------------------
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite

# -------------------- 前端 --------------------
# 开发环境用 /api/v1（Vite proxy 转发到后端），生产环境用 /api/v1（nginx 反代）
VITE_API_BASE_URL=/api/v1

# -------------------- 端口（docker-compose 用）--------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# -------------------- CORS（P0 安全加固）--------------------
# 允许的前端源（逗号分隔），必须与前端部署域名一致，且不能与 allow_credentials=true 同时使用 *
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# FE-SEC-03: 前端应用公网地址，用于后端生成完整邀请链接。为空则返回相对链接。
FRONTEND_URL=

# -------------------- Cookie（P1-1 HttpOnly Token + BE-SEC-01 CSRF）--------------------
# 运行影响审计 Fix2: 本模板 DEBUG=false（生产模式），COOKIE_SECURE 必须为 true，
# 否则 config.py 启动守卫会 raise RuntimeError 拒绝启动。
# 本地 HTTP 开发请改用 .env.dev.example（DEBUG=true 时 COOKIE_SECURE 可为 false）。
# 跨域部署（如 Vercel + Railway）且前端独立域名时，COOKIE_SAMESITE 需设为 None
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=your-domain.com
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token

# -------------------- 本地工具桥接（Local Runner）--------------------
# Backend 与 collaboration-service 之间共享的内部密钥（X-Bridge-Secret 鉴权）。
# 生产（DEBUG=false）必填，否则后端拒绝启动；两服务必须相同。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_INTERNAL_SECRET=
# 后端调用协作服务的内网地址（compose 内覆盖为 http://collaboration-service:3001）
COLLAB_SERVICE_URL=http://127.0.0.1:3001
# 本地 Runner 公网桥接地址（生成用户连接命令用；nginx 需把 /bridge 反代到协作服务）。
# 云端单域名部署时设为公网域名根，如 https://your-domain.com；本地开发可留空。
RUNNER_PUBLIC_BRIDGE_URL=
# 本地 Runner 公网分发包下载基地址（install.ps1 从中下载 local-runner.zip），
# 如 https://your-domain.com/local-runner
AUTOTEAMS_RUNNER_DOWNLOAD_BASE=

# -------------------- 协作服务 sandbox（AUD-02）--------------------
# collaboration-service 的模型工具在 sandbox 模式下默认拒绝 bash：
# 没有显式允许列表时，任何 bash 调用都被拒绝（fail-closed）。
# 下面四项均为**默认拒绝**的配置，需要放行某条命令时再显式开启。
# 允许执行的命令前缀，英文逗号分隔；留空 = 全部拒绝。
# 例：npm run build,git status
#COLLAB_SANDBOX_BASH_ALLOWLIST=
# 单条 bash 命令的最长执行时间（毫秒），超时即终止子进程。
#COLLAB_SANDBOX_BASH_TIMEOUT_MS=60000
# 单条 bash 命令的输出上限（字节），超出即截断，防止把内存/日志打满。
#COLLAB_SANDBOX_BASH_MAX_OUTPUT_BYTES=262144
# 逃生舱：允许执行允许列表之外的任意命令。默认 false。
# 打开会在日志里打印显式告警——它让模型可以在容器内执行任意代码，
# 只应在你已经用容器/沙箱做了真正隔离时启用。
#COLLAB_SANDBOX_ALLOW_UNRESTRICTED_BASH=false

# -------------------- 备份（P1-08 + P3-4）--------------------
# 备份输出目录
BACKUP_DIR=./backups
# 保留份数（超过此数量的旧备份会被 backup_rotate.sh 删除）
BACKUP_RETENTION_DAYS=30
# SQLite 数据库路径（仅 --sqlite 模式使用）
SQLITE_DB_PATH=./backend/autoteams.db
# 上传文件目录
UPLOADS_DIR=./backend/uploads
# P3-4: GPG 对称加密密码（为空则不加密）。生产环境必须设置强密码并异地保存。
BACKUP_ENCRYPTION_KEY=PLEASE_CHANGE_TO_STRONG_BACKUP_PASSWORD_AND_KEEP_OFFSITE
