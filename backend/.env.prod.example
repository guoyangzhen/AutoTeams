# ============================================================================
# AutoTeams Backend - 生产环境配置示例
# S2: 面向生产部署，强制 PostgreSQL + Redis，禁用调试模式
# 部署时复制为 .env.prod 并填入真实值；所有标 <REPLACE> 的字段必须替换
# ============================================================================

# Database - 生产环境必须使用 PostgreSQL，USE_SQLITE 必须为 false
USE_SQLITE=false
DATABASE_URL=postgresql+asyncpg://<REPLACE_USER>:<REPLACE_PASSWORD>@<REPLACE_HOST>:5432/<REPLACE_DB>

# Redis - 生产环境必须配置独立 Redis 实例
REDIS_URL=redis://<REPLACE_HOST>:6379/0

# ChromaDB - 生产环境推荐独立 ChromaDB 服务；留空则使用嵌入式模式
CHROMA_HOST=<REPLACE_HOST_OR_LEAVE_EMPTY>
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=<REPLACE_TOKEN_OR_LEAVE_EMPTY>

# JWT - 生产环境必须使用强随机密钥（至少 32 字符）
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=<REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=7

# LLM - 生产环境推荐使用国产模型降低成本
DEFAULT_LLM_PROVIDER=doubao
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_ALLOW_FALLBACK=true
LLM_FALLBACK_MODELS=deepseek-chat,qwen-plus

# 豆包 / 火山引擎
DOUBAO_API_KEY=<REPLACE_API_KEY>
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-32k
DOUBAO_MODEL_STRONG=doubao-pro-128k
DOUBAO_MODEL_CHEAP=doubao-lite-32k

# DeepSeek（备选）
DEEPSEEK_API_KEY=<REPLACE_API_KEY>
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_STRONG=deepseek-reasoner
DEEPSEEK_MODEL_CHEAP=deepseek-chat

# 通义千问（备选）
QWEN_API_KEY=<REPLACE_API_KEY>
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MODEL_STRONG=qwen-max
QWEN_MODEL_CHEAP=qwen-turbo

# 月之暗面 / Kimi（备选）
MOONSHOT_API_KEY=<REPLACE_API_KEY>
MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_MODEL_STRONG=moonshot-v1-32k
MOONSHOT_MODEL_CHEAP=moonshot-v1-8k

# 智谱 / GLM（备选）
ZHIPU_API_KEY=<REPLACE_API_KEY>
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4
ZHIPU_MODEL_STRONG=glm-4
ZHIPU_MODEL_CHEAP=glm-4-flash

# OpenAI（如需国际模型）
OPENAI_API_KEY=<REPLACE_API_KEY_OR_LEAVE_EMPTY>
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MODEL_STRONG=gpt-4
OPENAI_MODEL_CHEAP=gpt-3.5-turbo

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# RAG
RERANK_ENABLED=true
MAX_CONTEXT_TOKENS=6000

# Multimodal
MULTIMODAL_API_KEY=<REPLACE_API_KEY>
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_MODEL=gpt-4-vision-preview

# Server - 生产环境禁用调试
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LangGraph checkpoint - 生产环境使用持久化卷
LANGGRAPH_CHECKPOINT_PATH=/app/data/langgraph_checkpoints.sqlite

# 文件上传
UPLOAD_ROOT=/app/uploads

# CORS - 生产环境仅允许前端域名
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com

# 受信反向代理跳数（解析 X-Forwarded-For 真实客户端 IP）
# 生产部署在 nginx/Railway/Cloudflare 等代理后必须设置正确跳数（通常为 1，多层代理取实际层数）
TRUSTED_PROXY_COUNT=1

# 前端地址
FRONTEND_URL=https://your-frontend-domain.example.com

# 限流 - 生产环境适当收紧
RATE_LIMIT_SSE_PER_MINUTE=10

# ============================================================================
# 本地工具桥接（Local Runner）— 生产必填，否则后端拒绝启动
# ============================================================================
# Backend 与 collaboration-service 之间共享的内部密钥（X-Bridge-Secret 鉴权）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 必须与 collaboration-service 配置的 BRIDGE_INTERNAL_SECRET 完全相同。
BRIDGE_INTERNAL_SECRET=<REPLACE_WITH_STRONG_RANDOM_SECRET>
# 后端调用协作服务的内网地址（compose 内为 http://collaboration-service:3001）。
COLLAB_SERVICE_URL=http://127.0.0.1:3001
# 本地 Runner 公网桥接地址（用于生成用户本机连接命令；nginx 需把 /bridge 反代到协作服务）。
# 云端部署时为公网域名根，如 https://your-domain.com
RUNNER_PUBLIC_BRIDGE_URL=https://your-domain.com
# 本地 Runner 公网分发包下载基地址（install.ps1 从中下载 local-runner.zip）。
# 云端部署时为公网域名下的 /local-runner，如 https://your-domain.com/local-runner
AUTOTEAMS_RUNNER_DOWNLOAD_BASE=https://your-domain.com/local-runner
