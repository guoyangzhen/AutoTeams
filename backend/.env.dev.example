# ============================================================================
# AutoTeams Backend - 开发环境配置示例
# S2: 面向本地开发，使用 SQLite + 调试模式，降低外部依赖
# 复制本文件为 .env 即可快速启动本地开发
# ============================================================================

# Database - 开发环境使用 SQLite，零依赖启动
USE_SQLITE=true
DATABASE_URL=sqlite+aiosqlite:///./autoteams_dev.db

# Redis - 本地可选；未配置时限流回退到内存存储
REDIS_URL=redis://localhost:6379/0

# ChromaDB - 开发环境使用嵌入式模式（无需独立服务）
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=

# JWT - 开发环境使用固定密钥，生产环境必须替换
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# LLM - 开发默认使用 OpenAI，可切换为国产模型
DEFAULT_LLM_PROVIDER=openai
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=1
LLM_ALLOW_FALLBACK=false
LLM_FALLBACK_MODELS=

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MODEL_STRONG=gpt-4
OPENAI_MODEL_CHEAP=gpt-3.5-turbo

# 国产模型（按需取消注释并填入密钥）
# DEFAULT_LLM_PROVIDER=doubao
# DOUBAO_API_KEY=
# DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-pro-32k

# DEFAULT_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# DEFAULT_LLM_PROVIDER=qwen
# QWEN_API_KEY=
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# DEFAULT_LLM_PROVIDER=moonshot
# MOONSHOT_API_KEY=
# MOONSHOT_API_BASE=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k

# DEFAULT_LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# RAG
RERANK_ENABLED=true
MAX_CONTEXT_TOKENS=6000

# Multimodal
MULTIMODAL_API_KEY=your-api-key-here
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_MODEL=gpt-4-vision-preview

# Server - 开发环境开启调试
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LangGraph checkpoint
LANGGRAPH_CHECKPOINT_PATH=./langgraph_checkpoints.sqlite

# 文件上传
UPLOAD_ROOT=./uploads

# CORS - 开发环境允许本地前端端口
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# 受信反向代理跳数（开发环境通常直连，保持 0 即可；若经本地 nginx 代理设为 1）
TRUSTED_PROXY_COUNT=0

# 前端地址
FRONTEND_URL=http://localhost:5173

# 限流
RATE_LIMIT_SSE_PER_MINUTE=10
