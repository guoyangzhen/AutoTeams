# ============================================================================
# AutoTeams Backend Environment Configuration (通用示例)
# S2: 补充国产模型配置示例，支持 OpenAI 兼容接口的多家厂商
# 复制本文件为 .env 并填入真实值；开发环境可参考 .env.dev.example，生产环境参考 .env.prod.example
# ============================================================================

# Database - 本地开发可设为 true 使用 SQLite，生产环境必须改为 PostgreSQL
USE_SQLITE=true
DATABASE_URL=postgresql+asyncpg://autoteams:autoteams123@localhost:5432/autoteams

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================================
# LLM API 配置（OpenAI 兼容接口）
# 通过 DEFAULT_LLM_PROVIDER 切换厂商，各厂商使用各自前缀的变量
# ============================================================================

# 默认 LLM 提供商：openai / doubao / deepseek / qwen / moonshot / zhipu
DEFAULT_LLM_PROVIDER=openai

# 请求超时与重试（所有厂商共享）
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_ALLOW_FALLBACK=false
LLM_FALLBACK_MODELS=

# -------------------- OpenAI（国际） --------------------
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MODEL_STRONG=gpt-4
OPENAI_MODEL_CHEAP=gpt-3.5-turbo

# -------------------- 豆包 / 火山引擎（字节跳动） --------------------
# 文档：https://www.volcengine.com/docs/82379
# 模型示例：doubao-pro-32k / doubao-pro-128k / doubao-lite-32k
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-32k
DOUBAO_MODEL_STRONG=doubao-pro-128k
DOUBAO_MODEL_CHEAP=doubao-lite-32k

# -------------------- DeepSeek --------------------
# 文档：https://platform.deepseek.com/api-docs
# 模型示例：deepseek-chat / deepseek-coder / deepseek-reasoner
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_STRONG=deepseek-reasoner
DEEPSEEK_MODEL_CHEAP=deepseek-chat

# -------------------- 通义千问 / 阿里云百炼 --------------------
# 文档：https://help.aliyun.com/zh/dashscope
# 模型示例：qwen-max / qwen-plus / qwen-turbo
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MODEL_STRONG=qwen-max
QWEN_MODEL_CHEAP=qwen-turbo

# -------------------- 月之暗面 / Kimi --------------------
# 文档：https://platform.moonshot.cn/docs
# 模型示例：moonshot-v1-8k / moonshot-v1-32k / moonshot-v1-128k
MOONSHOT_API_KEY=your-moonshot-api-key-here
MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_MODEL_STRONG=moonshot-v1-32k
MOONSHOT_MODEL_CHEAP=moonshot-v1-8k

# -------------------- 智谱 / GLM --------------------
# 文档：https://open.bigmodel.cn/dev/api
# 模型示例：glm-4 / glm-4-air / glm-4-flash
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4
ZHIPU_MODEL_STRONG=glm-4
ZHIPU_MODEL_CHEAP=glm-4-flash

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# RAG
RERANK_ENABLED=true
MAX_CONTEXT_TOKENS=6000

# Multimodal LLM（视觉理解）
MULTIMODAL_API_KEY=your-api-key-here
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_MODEL=gpt-4-vision-preview

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LangGraph checkpoint 持久化路径
# 本地开发默认使用 ./langgraph_checkpoints.sqlite
# Docker/Railway 生产环境应覆盖为 /app/data/langgraph_checkpoints.sqlite
LANGGRAPH_CHECKPOINT_PATH=./langgraph_checkpoints.sqlite

# 文件上传根目录
UPLOAD_ROOT=./uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# 受信反向代理跳数（用于解析 X-Forwarded-For 中的真实客户端 IP）
# 0 = 不信任任何代理（默认，使用直连 IP）；部署在 nginx/Railway/Cloudflare 等代理后通常设为 1
TRUSTED_PROXY_COUNT=0

# 前端地址（用于生成完整链接）
FRONTEND_URL=

# 限流（C3 分类维护，此处仅占位）
RATE_LIMIT_SSE_PER_MINUTE=10
